<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>

        <shape android:shape="rectangle">

            <corners android:radius="22dp" />

            <gradient
                android:angle="135"
                android:startColor="#401D4D"
                android:centerColor="#29183B"
                android:endColor="#171021" />

            <stroke
                android:width="1dp"
                android:color="@color/pompnet_border" />

        </shape>

    </item>

</layer-list>
